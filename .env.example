# Copy to .env and fill in values.
# This project runs:
# - Vite web dev server on http://localhost:5173
# - Express API server on http://localhost:5174 (Vite proxies /api -> API)

# --- API ---
API_PORT=5174

# --- Auth ---
# Any long random string is fine for local dev.
AUTH_JWT_SECRET=replace_me_with_a_long_random_string

# --- EODHD ---
# Server-side token used to fetch & cache stock data in DB.
EODHD_API_TOKEN=replace_me

# --- Database (MySQL/MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dividend_planner
DB_PASSWORD=replace_me
DB_DATABASE=dividend_planner

# Optional
# DB_POOL_SIZE=10
# NODE_ENV=development
